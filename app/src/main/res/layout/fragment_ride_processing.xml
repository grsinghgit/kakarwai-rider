<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="80dp">

        <!-- Ride ID -->
        <TextView
            android:id="@+id/tvRideId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ride ID: #12345"
            android:textSize="14sp"
            android:textColor="@color/grey"
            android:layout_marginBottom="8dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ Searching for driver..."
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/orange"
            android:layout_marginBottom="8dp" />

        <!-- Timer -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ 5:00 remaining"
            android:textSize="16sp"
            android:textColor="@color/red"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- ✅ CANCEL BUTTON - Top par (Status ke neeche) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="❌ Cancel Ride"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="@color/red"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- RIDE DETAILS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRideDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 Ride Details"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvPickup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Pickup: Connaught Place"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDestination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏁 Destination: India Gate"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvVehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚗 Car"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <!-- ✅ Distance Breakdown -->
                <TextView
                    android:id="@+id/tvDistanceBreakdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 5.2km + 8.3km = 13.5km"
                    android:textSize="13sp"
                    android:textColor="@color/grey"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱️ 10 min"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <!-- ✅ Estimated Fare -->
                <TextView
                    android:id="@+id/tvEstimatedFare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 Estimated Fare: ₹170"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/orange" />

                <!-- ✅ Total Fare -->
                <TextView
                    android:id="@+id/tvTotalFare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 Total Fare: ₹170"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/green"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DRIVER DETAILS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDriverDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 Driver Details"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Driver Name + Call Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvDriverName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🚗 Amit Kumar"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCallDriver"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="📞 Call"
                        app:cornerRadius="8dp"
                        android:textSize="11sp"
                        app:backgroundTint="@color/blue"
                        android:textColor="@color/white"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDriverPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 +91 9876543210"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDriverVehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚙 Swift | HR26AB1234"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PAYMENT SECTION -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💳 Payment Method"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/rbCash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 Cash"
                    android:checked="true"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/rbOnline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Online (Coming Soon)"
                    android:enabled="false"
                    android:alpha="0.5"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Please confirm payment method to start ride"
                    android:textSize="12sp"
                    android:textColor="@color/grey" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CONFIRM BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmRide"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✅ Confirm &amp; Start Ride"
            app:cornerRadius="12dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            app:backgroundTint="@color/green" />

        <!-- Refresh Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Refresh"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="@color/primary"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>