<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Top Bar -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                android:padding="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ride Processing"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- Timer -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ 5m 0s remaining"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="@color/red" />

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ Searching for driver..."
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/orange" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary"
        android:layout_margin="16dp" />

    <!-- Ride Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRideDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvRideId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ride ID: #ABC123"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Connaught Place, Delhi"
                android:textSize="13sp"
                android:textColor="@color/grey"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏁 India Gate, Delhi"
                android:textSize="13sp"
                android:textColor="@color/grey" />

            <TextView
                android:id="@+id/tvVehicle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚗 Car"
                android:textSize="13sp"
                android:textColor="@color/grey"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 12.5 km"
                    android:textSize="13sp"
                    android:textColor="@color/grey" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⏱️ 25 min"
                    android:textSize="13sp"
                    android:textColor="@color/grey" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvFare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰 ₹236"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Driver Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDriverDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDriverName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚗 Driver Name"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDriverPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 +91 9876543210"
                android:textSize="13sp"
                android:textColor="@color/grey" />

            <TextView
                android:id="@+id/tvDriverVehicle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚙 Maruti Swift | DL-01-AB-1234"
                android:textSize="13sp"
                android:textColor="@color/grey" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Start Ride Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartRide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:text="🚗 Start Ride"
        app:cornerRadius="8dp"
        app:backgroundTint="@color/green"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Refresh Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRefresh"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="🔄 Refresh Status"
        app:cornerRadius="8dp"
        app:backgroundTint="@color/blue"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="visible" />

    <!-- ✅ Cancel Button - Hidden -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="❌ Cancel Ride"
        app:cornerRadius="8dp"
        app:backgroundTint="@color/red"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone" />   <!-- ✅ GONE -->

</LinearLayout>