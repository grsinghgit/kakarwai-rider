<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👋 Welcome!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 Loading..."
            android:textSize="14sp"
            android:textColor="@color/grey"
            android:layout_marginBottom="16dp" />

        <!-- Service Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardServiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/primary_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvServiceStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 Checking service availability..."
                    android:textSize="14sp"
                    android:textColor="@color/primary_dark" />

                <ProgressBar
                    android:id="@+id/progressServiceCheck"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminateTint="@color/primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Service Unavailable Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardServiceUnavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/orange_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚫"
                    android:textSize="40sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service Unavailable"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/orange_dark"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We are currently serving within 50km radius."
                    android:textSize="13sp"
                    android:textColor="@color/orange_dark"
                    android:gravity="center"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ✅ BOOK RIDE - Big Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardBookRide"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚗"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Book a Ride"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Go anywhere, anytime"
                        android:textSize="14sp"
                        android:textColor="#CCFFFFFF" />

                </LinearLayout>

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_book_ride"
                    android:tint="@color/white"
                    android:background="@drawable/bg_white_circle" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Other Services Grid -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="More Services"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="12dp" />

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:columnCount="2"
            app:rowCount="3"
            android:layout_marginTop="4dp">

            <!-- Buy/Sell -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBuySell"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_margin="6dp"
                app:layout_columnWeight="1"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛒"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buy/Sell"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Marketplace"
                        android:textSize="11sp"
                        android:textColor="@color/grey" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Room on Rent -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRoomRent"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_margin="6dp"
                app:layout_columnWeight="1"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏠"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Room Rent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Find your space"
                        android:textSize="11sp"
                        android:textColor="@color/grey" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Food Delivery -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFoodDelivery"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_margin="6dp"
                app:layout_columnWeight="1"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍔"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Food Delivery"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order food"
                        android:textSize="11sp"
                        android:textColor="@color/grey" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Goods Delivery -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGoodsDelivery"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_margin="6dp"
                app:layout_columnWeight="1"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Goods Delivery"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Send parcels"
                        android:textSize="11sp"
                        android:textColor="@color/grey" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Coming Soon -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardComingSoon"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_margin="6dp"
                app:layout_columnWeight="1"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Coming Soon"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New features"
                        android:textSize="11sp"
                        android:textColor="@color/grey" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </androidx.gridlayout.widget.GridLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kakarwai Rider v1.0"
            android:textSize="12sp"
            android:textColor="@color/grey"
            android:gravity="center"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>