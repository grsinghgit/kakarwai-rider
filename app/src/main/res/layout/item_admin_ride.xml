<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Ride ID & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRideId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ride #ABC123"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textSize="12sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

        </LinearLayout>

        <!-- User Phone -->
        <TextView
            android:id="@+id/tvUserPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 +91 9876543210"
            android:textSize="12sp"
            android:textColor="@color/grey"
            android:layout_marginTop="4dp" />

        <!-- Pickup & Destination -->
        <TextView
            android:id="@+id/tvPickup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Pickup: Connaught Place"
            android:textSize="12sp"
            android:textColor="@color/grey"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvDestination"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏁 Destination: India Gate"
            android:textSize="12sp"
            android:textColor="@color/grey" />

        <!-- ✅ Distances -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvDistanceCenterToPickup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📏 Center→Pickup: 0.0 km"
                android:textSize="11sp"
                android:textColor="@color/grey" />

            <TextView
                android:id="@+id/tvDistancePickupToDest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📏 Pickup→Dest: 0.0 km"
                android:textSize="11sp"
                android:textColor="@color/grey" />

        </LinearLayout>

        <!-- Fare & Vehicle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvFare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💰 ₹236"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tvVehicle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚗 Car"
                android:textSize="12sp"
                android:textColor="@color/grey" />

        </LinearLayout>

        <!-- ✅ Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- Call Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="📞 Call"
                app:cornerRadius="8dp"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:icon="@drawable/ic_call"
                app:iconGravity="textStart" />

            <!-- Google Maps Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoute"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🗺️ Route"
                app:cornerRadius="8dp"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:icon="@drawable/ic_map"
                app:iconGravity="textStart" />

        </LinearLayout>

        <!-- Assign Driver Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAssignDriver"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="Assign Driver"
            app:cornerRadius="8dp"
            android:textSize="12sp"
            app:backgroundTint="@color/green"
            android:visibility="visible" />

        <!-- ✅ Cancel Ride Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelRide"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:text="❌ Cancel Ride"
            app:cornerRadius="8dp"
            android:textSize="12sp"
            app:backgroundTint="@color/red"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>