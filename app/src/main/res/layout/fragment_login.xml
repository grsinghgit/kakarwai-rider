<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:layout_gravity="center">

        <!-- Logo -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_splash_logo"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗 Kakarwai Rider"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in with Google"
            android:textSize="16sp"
            android:textColor="@color/grey"
            android:layout_marginBottom="16dp" />

        <!-- Service Status -->
        <TextView
            android:id="@+id/tvServiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Checking service availability..."
            android:textSize="14sp"
            android:textColor="@color/orange"
            android:gravity="center"
            android:padding="8dp"
            android:background="@color/grey_light"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- ✅ Google Sign-In Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🟢 Sign in with Google"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp"
            android:enabled="false"
            android:alpha="0.5" />

        <!-- Accept Terms Checkbox -->
        <CheckBox
            android:id="@+id/cbAcceptTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="I accept the Terms and Conditions"
            android:textSize="14sp"
            android:textColor="@color/black" />

        <!-- Privacy Policy & Terms Links -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvPrivacyPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜 Privacy Policy"
                android:textSize="13sp"
                android:textColor="@color/primary"
                android:padding="4dp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" | "
                android:textSize="13sp"
                android:textColor="@color/grey" />

            <TextView
                android:id="@+id/tvTermsConditions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Terms &amp; Conditions"
                android:textSize="13sp"
                android:textColor="@color/primary"
                android:padding="4dp"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <!-- Contact Info -->
        <TextView
            android:id="@+id/tvContactInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞 Indrajeet Singh (RINKU) | +91 9956505353\n✉️ kakarwairider@gmail.com"
            android:textSize="11sp"
            android:textColor="@color/grey"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:padding="8dp" />

    </LinearLayout>

</ScrollView>